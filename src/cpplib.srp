            <__p_description>This contains the C++ language implementation.</__p_description>
            <__p_name>Cpp</__p_name>
            <Enumeration>
                <__p_class>0</__p_class>
                <__p_description>This enumerates all access types for C++ blocks whose parent is a class block. In order to expand this enumeration one must use the user access as the first new enumeration.</__p_description>
                <__p_name>Access</__p_name>
            </Enumeration>
            <Enumeration>
                <__p_class>0</__p_class>
                <__p_description>This enumerates all possible code keys. See the code key function for further details.</__p_description>
                <__p_name>CodeKey</__p_name>
            </Enumeration>
            <Enumeration>
                <__p_class>0</__p_class>
                <__p_description>This enumerates all function assignments for C++ function blocks. In order to expand this enumeration one must use the user function assignment as the first new enumeration.</__p_description>
                <__p_name>FunctionAssignment</__p_name>
            </Enumeration>
            <Enumeration>
                <__p_class>0</__p_class>
                <__p_description>This enumerates all function flags for C++ function blocks. Each flag takes one bit of an integer. In order to expand this enumeration one must use unused bits to the left starting with the user function flag bit.</__p_description>
                <__p_name>FunctionFlags</__p_name>
            </Enumeration>
            <Enumeration>
                <__p_class>0</__p_class>
                <__p_description>This enumerates all function types for C++ function blocks. In order to expand this enumeration one must use the user function type as the first new enumeration.</__p_description>
                <__p_name>FunctionType</__p_name>
            </Enumeration>
            <Enumeration>
                <__p_class>0</__p_class>
                <__p_description>This enumerates all source code versions for C++ parsing and building.</__p_description>
                <__p_name>Version</__p_name>
            </Enumeration>
